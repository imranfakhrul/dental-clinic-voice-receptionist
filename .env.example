# Copy to .env (git-ignored) and fill in locally. Never commit real values.
# Open Dental (P0-12, docs/integrations/open-dental-access.md section 4)
OPEN_DENTAL_BASE_URL=https://api.opendental.com/api/v1
# Today: the published hosted-test credentials from https://www.opendental.com/site/apisetup.html
OD_DEVELOPER_KEY=
OD_CUSTOMER_KEY=
# hosted = Open Dental's public test database (read-only); testdb = our own synthetic test database (B)
OD_TARGET=hosted

# Gemini (P0-13, docs/adr/0001-gemini-models.md). Two backends:
#   vertex    = production and any PHI; US endpoint only (VERTEX_LOCATION=us)
#   developer = Gemini Developer API key from Google AI Studio; ONLY with APP_ENV=local and synthetic data
APP_ENV=local
GEMINI_BACKEND=developer
GEMINI_API_KEY=
VERTEX_PROJECT=dai-rcpt-dev
VERTEX_LOCATION=us
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-4-argon
GEMINI_ALLOWED_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.5-flash,gemini-4-argon

# WhatsApp test sender, Meta Cloud API (P0-07, P0-15). Testing only: synthetic data, team phones.
# Load into the shell before running scripts/messaging/*.py:  set -a; . ./.env; set +a
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_WABA_ID=
WA_TEST_TO=
WA_GRAPH_VERSION=v27.0
