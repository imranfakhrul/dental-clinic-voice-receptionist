{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vendor/BAA matrix",
  "type": "object",
  "required": [
    "schema_version",
    "reviewed_on",
    "reviewed_by",
    "vendors",
    "clinics",
    "phi_gate"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reviewed_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "services",
          "phi",
          "environments",
          "baa",
          "owner",
          "tasks"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "phi": {
            "enum": [
              "yes",
              "no",
              "conditional"
            ]
          },
          "phi_condition": {
            "type": "string"
          },
          "no_phi_control": {
            "type": "string"
          },
          "environments": {
            "type": "array",
            "items": {
              "enum": [
                "dev",
                "staging",
                "prod",
                "ops",
                "team"
              ]
            },
            "minItems": 1
          },
          "baa": {
            "type": "object",
            "required": [
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "signed",
                  "pending",
                  "under_review",
                  "not_required"
                ]
              },
              "type": {
                "enum": [
                  "click_through",
                  "signed_contract",
                  "clinic_arrangement"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "record": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "product_list": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P\\d-\\d{2}[a-z]?$"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "clinics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "clinic_slug",
          "baa"
        ],
        "additionalProperties": false,
        "properties": {
          "clinic_slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "baa": {
            "type": "object",
            "required": [
              "status"
            ],
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "signed",
                  "pending"
                ]
              },
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "record": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "phi_gate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "task",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "description": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "status": {
            "enum": [
              "done",
              "pending"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
